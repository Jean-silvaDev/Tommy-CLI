# ==============================================================================
# TOMMY CLI - MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Copie este arquivo para '.env' para definir suas configurações locais.
# NUNCA insira senhas reais ou segredos neste arquivo modelo (.env.example).
# ==============================================================================

# Ambiente de Execução (development / production)
TOMMY_ENV=development

# Diretório para saída dos artefatos e prompts gerados pelo PromptBuilder
TOMMY_OUTPUT_DIR=./PromptBuilder

# Diretório de configurações globais e presets do usuário (~/.tommy)
TOMMY_CONFIG_DIR=~/.tommy

# Nome ou identificador do Autor da sessão do PromptBuilder (opcional)
TOMMY_AUTHOR=

# Caminho customizado para o executável do Docker Desktop (opcional)
# Exemplo Windows: C:\Program Files\Docker\Docker\Docker Desktop.exe
TOMMY_DOCKER_PATH=

# Pasta(s) temporária(s) customizada(s) adicional(is) para limpeza (separadas por vírgula)
TOMMY_TEMP_DIR=
TOMMY_SYS_TEMP_DIR=

# Diretório de Lixeira / Trash customizado (opcional)
TOMMY_TRASH_DIR=

# Nível de Logs da Aplicação (debug / info / warn / error)
TOMMY_LOG_LEVEL=info

# Idioma Padrão da Interface
TOMMY_LANGUAGE=pt-BR

